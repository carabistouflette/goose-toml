  "reproducer_source": "import hashlib,json,os,platform,random,statistics,subprocess,sys,time\nfrom pathlib import Path\nwork=Path(__file__).resolve().parent\nroot=work.parents[2]\nmanifest_path=root.parent/'goose-toml-edit/.build/reuse-benchmark-runners-a79cf60.json'\nmanifest=json.loads(manifest_path.read_text())\nhashfile=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nassert hashfile(manifest['compiler'])==manifest['compiler_sha256']\ndef verify():\n for name,row in manifest['runners'].items():\n  assert hashfile(row['binary'])==row['binary_sha256']\n  for file,digest in row['source_files_sha256'].items():assert hashfile(Path(row['source'])/file)==digest\nverify();os.sched_setaffinity(0,{6})\nreport={'started_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'cpu':6,'platform':platform.platform(),'cpu_model':next(x.split(':',1)[1].strip() for x in Path('/proc/cpuinfo').read_text().splitlines() if x.startswith('model name')),'protocol':'aggregated_batches_v2','target_batch_ns':30000000,'minimum_batch_ns':10000000,'seed':20261104,'manifest_sha256':hashfile(manifest_path),'compiler_sha256':manifest['compiler_sha256'],'provenance':manifest,'script_sha256':hashfile(__file__),'samples':[],'scope':'Six unchanged public-call workloads; intentional editor-only overlay of ae32; shared host; exact output handled by separate parity/alias suites, checksum checks here; fixture construction outside runner timer.'}\ncases=['set','insert','remove','wide','deep','comments'];percall={}\ndef run(name,case,count,batches=1):\n rows=[]\n for _ in range(batches):\n  r=subprocess.run([manifest['runners'][name]['binary'],case,str(count)],text=True,capture_output=True,check=True,timeout=120);assert not r.stderr\n  ns,checksum=map(int,r.stdout.split());assert ns>0 and checksum>0 and checksum%count==0\n  current=checksum//count;assert case not in percall or percall[case]==current;percall[case]=current\n  rows.append({'ns':ns,'iterations':count,'checksum':checksum})\n total=sum(row['ns'] for row in rows)\n return {'ns':total,'iterations':count*batches,'checksum':sum(row['checksum'] for row in rows),'minimum_met':total>=10000000,'calls_per_batch':count,'batches':batches,'subsamples':rows}\nif sys.argv[1]=='calibrate':\n report['calibration_samples']=[];report['cases']=[]\n for case in cases:\n  count=1 if case in ['wide','comments'] else 1000\n  batches=1\n  while True:\n   pair={name:run(name,case,count,batches) for name in manifest['runners']};report['calibration_samples'].append({'case':case,'iterations':count,'batches':batches,'samples':pair})\n   if min(row['ns'] for row in pair.values())>=30000000 or (count==10000 and batches==32):break\n   if count<10000:count=min(count*2,10000)\n   else:batches*=2\n  report['cases'].append({'case':case,'iterations':count,'batches':batches,'minimum_met':all(row['minimum_met'] for row in pair.values())})\n destination=work/'public-batched-calibration.json'\nelse:\n cfg=json.loads((work/'public-batched-calibration.json').read_text());assert cfg['manifest_sha256']==report['manifest_sha256'] and cfg['script_sha256']==report['script_sha256'] and cfg['compiler_sha256']==report['compiler_sha256']\n report['config_sha256']=hashfile(work/'public-batched-calibration.json');report['cases']=cfg['cases'];rng=random.Random(20261104)\n for round_id in range(9):\n  order=list(cfg['cases']);rng.shuffle(order)\n  for item in order:\n   case=item['case'];count=item['iterations'];batches=item['batches']\n   for name in (list(manifest['runners']) if (round_id+cases.index(case))%2==0 else list(reversed(manifest['runners']))):\n    report['samples'].append({'round':round_id,'runner':name,'case':case,**run(name,case,count,batches)})\n report['ratios_of_medians']=[]\n for item in cfg['cases']:\n  case=item['case'];med={name:statistics.median(row['ns']/row['iterations'] for row in report['samples'] if row['runner']==name and row['case']==case) for name in manifest['runners']}\n  report['ratios_of_medians'].append({'case':case,'ns_per_op':med,'candidate_over_baseline':med['candidate']/med['baseline'],'eligible_for_timing_claim':item['minimum_met'] and all(row['minimum_met'] for row in report['samples'] if row['case']==case)})\n destination=work/sys.argv[1]\nverify();assert hashfile(manifest_path)==report['manifest_sha256'] and hashfile(manifest['compiler'])==report['compiler_sha256']\nreport['completed_utc']=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime());report['reproducer_source']=Path(__file__).read_text();destination.write_text(json.dumps(report,indent=2)+'\\n');print(destination)\n",
